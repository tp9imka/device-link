<resources>
 <style name="Theme.Sample" parent="@android:style/Theme.Material.Light.NoActionBar">
  <item name="android:colorPrimary">@color/accent</item>
  <item name="android:colorAccent">@color/accent</item>
  <item name="android:windowBackground">@color/background</item>
  <item name="android:statusBarColor">@color/background</item>
  <item name="android:navigationBarColor">@color/background</item>
  <item name="android:windowLightStatusBar">true</item>
  <item name="android:textColorPrimary">@color/on_surface</item>
  <item name="android:textColorSecondary">@color/muted</item>
 </style>
 <style name="Card"><item name="android:background">@drawable/card</item><item name="android:padding">16dp</item></style>
 <style name="Title"><item name="android:textSize">22sp</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/on_surface</item></style>
 <style name="Heading"><item name="android:textSize">16sp</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/on_surface</item></style>
 <style name="Body"><item name="android:textSize">14sp</item><item name="android:textColor">@color/muted</item></style>
 <style name="PrimaryButton" parent="@android:style/Widget.Material.Button.Colored">
  <item name="android:minHeight">48dp</item><item name="android:textAllCaps">false</item><item name="android:textSize">15sp</item>
 </style>
 <style name="SecondaryButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
  <item name="android:minHeight">48dp</item><item name="android:textAllCaps">false</item><item name="android:textSize">15sp</item>
 </style>
</resources>
