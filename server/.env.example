# Copy to .env (git-ignored) for docker compose. Never commit real values.
RELAY_PUBLIC_URL=https://relay.example.org
RELAY_ENROLLMENT_TOKEN=replace-with-a-long-random-string
RELAY_ADMIN_USERNAME=admin
RELAY_ADMIN_PASSWORD_HASH=
RELAY_SESSION_SECRET=replace-with-64-random-hex-characters
# Named Cloudflare tunnel token (Zero Trust > Networks > Tunnels). Only used with --profile tunnel.
TUNNEL_TOKEN=
