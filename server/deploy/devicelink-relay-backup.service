[Unit]
Description=DeviceLink relay database backup (SQLite online backup API)

[Service]
Type=oneshot
User=devicelink-relay
Group=devicelink-relay
WorkingDirectory=/opt/devicelink-relay
Environment=RELAY_DATABASE=/var/lib/devicelink-relay/relay.sqlite3
EnvironmentFile=-/etc/devicelink-relay/environment
ExecStart=/opt/devicelink-relay/.venv/bin/python -m relay.backup /var/backups/devicelink-relay --keep 14
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/devicelink-relay
ReadWritePaths=/var/backups/devicelink-relay
